<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>InventorySystem.InventoryService</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Protobuf Include="..\..\protos\inventory.proto" GrpcServices="Server" Link="Protos\inventory.proto" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.AspNetCore" Version="2.71.0" />
  </ItemGroup>

</Project>
